OPENAI_API_KEY=
AI_PROVIDER=openai
AI_USE_RESPONSES_API=true
AI_MODEL_TRIAGE=gpt-5.5
AI_MODEL_QUESTIONS=gpt-5.5
AI_MODEL_REPORT=gpt-5.5
AI_MODEL_LIGHT=gpt-4.1-mini
AI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
# OPENAI_VOICE_ANALYSIS_MODEL - экспериментальный анализ особенностей голоса через аудиомодель
# Доступные: gpt-audio-1.5, gpt-audio. Если оставить пустым — анализ отключён.
OPENAI_VOICE_ANALYSIS_MODEL=gpt-audio-1.5
AI_MODEL_FALLBACK=gpt-4.1-mini
AI_REASONING_EFFORT=medium
AI_MODEL_QUALITY_REVIEW=gpt-5.5
AI_QUALITY_REASONING_EFFORT=medium
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SECRET=
SUPER_ADMIN_TOKEN=
SUPPORT_ADMIN_TOKEN=
BODY_ADMIN_TOKEN=
PRIVACY_SAFE_MODE=true

# === Security Pass 2 — API Protection ===
# CLIENT_API_SIGNING_SECRET: HMAC key for short-lived client tokens (analyze/transcribe)
# Generate: openssl rand -hex 32
# CLIENT_API_SIGNING_SECRET=
#
# Vercel KV / Upstash Redis for production rate limiting (optional, in-memory fallback)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# LEGACY_SESSION_ACCESS_ENABLED: if true, sessions without access_token can still be read.
# Set to false after all active sessions have generated access tokens.
# LEGACY_SESSION_ACCESS_ENABLED=true

# Model Router (новое в v1.0.0)
# AI_PROVIDER — активный провайдер: openai | deepseek | yandex | gigachat | claude | gemini
# PATIENT_MODEL, REPORT_MODEL, QUALITY_MODEL, TRANSCRIPTION_MODEL —
#   логические модели для каждого типа задач.
#   Поддерживаемые значения: terra | sol | luna или конкретная модель провайдера.
# PATIENT_MODEL=terra
# REPORT_MODEL=sol
# QUALITY_MODEL=sol
# TRANSCRIPTION_MODEL=terra

# === Clinical Council Email ===
# COUNCIL_EMAIL_PROVIDER: console | resend
# COUNCIL_EMAIL_API_KEY: Resend API key (if provider=resend)
# COUNCIL_EMAIL_FROM: sender address (also used for test sends)
# COUNCIL_EMAIL_REPLY_TO: optional reply-to address
# COUNCIL_EMAIL_PROVIDER=
# COUNCIL_EMAIL_API_KEY=
# COUNCIL_EMAIL_FROM=
# COUNCIL_EMAIL_REPLY_TO=
