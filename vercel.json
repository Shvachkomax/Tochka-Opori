{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/sec-003-legacy-bypass": false
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/.*|audio/.*|support-practices/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/analyze.js": {
      "maxDuration": 300
    },
    "api/transcribe.js": {
      "includeFiles": "node_modules/opusscript/build/**"
    },
    "api/live-socket.js": {
      "maxDuration": 300
    }
  }
}
