{
  "rewrites": [
    {
      "source": "/((?!api/.*|audio/.*|support-practices/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/analyze.js": {
      "maxDuration": 300
    },
    "api/transcribe.js": {
      "includeFiles": "node_modules/opusscript/build/**"
    },
    "api/live-socket.js": {
      "maxDuration": 300
    }
  }
}
