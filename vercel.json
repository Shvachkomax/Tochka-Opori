{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/clinical-knowledge.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/medical-staging-specialist-disabled.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/clinical-knowledge",
      "dest": "/api/clinical-knowledge.js"
    },
    {
      "src": "/api/specialist",
      "dest": "/api/medical-staging-specialist-disabled.js"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!support-practices/).*)",
      "dest": "/index.html"
    }
  ]
}
